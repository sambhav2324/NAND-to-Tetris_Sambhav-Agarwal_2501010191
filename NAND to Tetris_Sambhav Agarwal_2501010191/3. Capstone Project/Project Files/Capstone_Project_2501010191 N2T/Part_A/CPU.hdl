CHIP CPU {
    IN inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    Mux16(a=aOut, b=inM, sel=instruction[12], out=yValue);
    ALU(x=dOut, y=yValue,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9], ny=instruction[8],
        f=instruction[7], no=instruction[6],
        out=aluOut, zr=zr, ng=ng);

    Not(in=instruction[15], out=isAInstruction);
    And(a=instruction[15], b=instruction[5], out=loadAFromC);
    Or(a=isAInstruction, b=loadAFromC, out=loadA);
    Mux16(a=aluOut, b=instruction, sel=isAInstruction, out=aIn);
    ARegister(in=aIn, load=loadA, out=aOut, out[0..14]=addressM);

    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dOut);

    And(a=instruction[15], b=instruction[3], out=writeM);
    Or16(a=aluOut, b[0..15]=false, out=outM);

    Not(in=ng, out=notNg);
    Not(in=zr, out=notZr);
    And(a=notNg, b=notZr, out=isPositive);
    And(a=instruction[0], b=isPositive, out=jumpGT);
    And(a=instruction[1], b=zr, out=jumpEQ);
    And(a=instruction[2], b=ng, out=jumpLT);
    Or(a=jumpGT, b=jumpEQ, out=jumpGTEQ);
    Or(a=jumpGTEQ, b=jumpLT, out=jump);

    PC(in=aOut, load=jump, inc=true, reset=reset, out=pc);
}
